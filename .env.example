# ============================================================
# App
# ============================================================
NODE_ENV=development
PORT=5000
APP_NAME=NestJS Boilerplate MongoDB
CORS_ORIGIN=http://localhost:3000

# ============================================================
# Database
# Local machine MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/nestjs_boilerplate
#
# Docker compose local MongoDB:
# MONGO_URI=mongodb://mongo:27017/nestjs_boilerplate
#
# Production recommended: MongoDB Atlas URI
# ============================================================
MONGO_URI=mongodb://127.0.0.1:27017/nestjs_boilerplate

# ============================================================
# Auth / JWT
# Production-e sob secret strong random string diye replace korte hobe.
# ============================================================
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE=1h
BCRYPT_SALT_ROUNDS=10
ACCESS_TOKEN_SECRET=change-me-access-token-secret
ACCESS_TOKEN_EXPIRES=7d
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
REFRESH_TOKEN_EXPIRES=90d

# ============================================================
# Cloudinary Uploads (optional)
# Empty thakle app start hobe, but upload endpoint config error debe.
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nestjs-boilerplate

# ============================================================
# Email / Nodemailer (optional)
# Gmail use korle EMAIL_PASS hobe app password.
# ============================================================
EMAIL_EXPIRES=900000
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_ADDRESS=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=
ADMIN_EMAIL=
EMAIL_SENDER_NAME=NestJS Boilerplate

# ============================================================
# Stripe Payments (optional)
# ============================================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_ACCOUNT_ID=

# ============================================================
# OAuth / Frontend URLs (optional)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000/api/v1

# ============================================================
# Docker / Local Compose
# Local build default:
# DOCKER_IMAGE=nestjs-boilerplate-mongodb:local
#
# Production deploy:
# DOCKER_IMAGE=your-dockerhub-username/nestjs-boilerplate-mongodb:latest
# ============================================================
DOCKER_USERNAME=
DOCKER_IMAGE_NAME=nestjs-boilerplate-mongodb
DOCKER_IMAGE=nestjs-boilerplate-mongodb:local
IMAGE_TAG=latest
APP_PORT=5000
APP_CONTAINER_NAME=nestjs_boilerplate_api

# ============================================================
# Optional local MongoDB container settings
# Only used with:
# docker compose --profile local up -d --build
# ============================================================
MONGO_DATABASE=nestjs_boilerplate
MONGO_PORT=27017
MONGO_CONTAINER_NAME=nestjs_boilerplate_mongo
